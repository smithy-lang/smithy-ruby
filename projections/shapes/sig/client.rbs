module ShapeService
  class Client < Smithy::Client::Base
    include Smithy::Client::Stubs

    def self.new: (
      ?convert_params: bool,
      ?endpoint: String,
      ?endpoint_provider: ShapeService::EndpointProvider,
      ?http_ca_file: String,
      ?http_ca_path: String,
      ?http_cert: OpenSSL::X509::Certificate,
      ?http_cert_store: OpenSSL::X509::Store,
      ?http_continue_timeout: Numeric,
      ?http_debug_output: bool,
      ?http_keep_alive_timeout: Numeric,
      ?http_key: OpenSSL::PKey::RSA | OpenSSL::PKey::DSA,
      ?http_open_timeout: Numeric,
      ?http_proxy: URI::HTTP | String,
      ?http_read_timeout: Numeric,
      ?http_ssl_timeout: Numeric,
      ?http_verify_mode: Integer,
      ?http_write_timeout: Numeric,
      ?log_level: Symbol,
      ?logger: Logger,
      ?protocol: String | Class,
      ?raise_response_errors: bool,
      ?stub_responses: bool,
      ?validate_params: bool,
    ) -> void
    | (?Hash[Symbol, untyped]) -> void

    interface _OperationResponse
      include Smithy::Client::_Output[Types::OperationInputOutput]
      def blob: () -> String?
      def boolean: () -> bool?
      def string: () -> String?
      def byte: () -> Integer?
      def short: () -> Integer?
      def integer: () -> Integer?
      def long: () -> Integer?
      def float: () -> Float?
      def double: () -> Float?
      def big_integer: () -> untyped?
      def big_decimal: () -> untyped?
      def timestamp: () -> Time?
      def document: () -> untyped?
      def enum: () -> String?
      def int_enum: () -> Integer?
      def list: () -> Array[String]?
      def map: () -> Hash[String, String]?
      def structure: () -> Types::Structure?
      def union: () -> Types::Union?
    end
      def operation: (
        ?blob: String,
        ?boolean: bool,
        ?string: String,
        ?byte: Integer,
        ?short: Integer,
        ?integer: Integer,
        ?long: Integer,
        ?float: Float,
        ?double: Float,
        ?big_integer: untyped,
        ?big_decimal: untyped,
        ?timestamp: Time,
        ?document: untyped,
        ?enum: String,
        ?int_enum: Integer,
        ?list: Array[String],
        ?map: Hash[String, String],
        ?structure: {
          member: String
        },
        ?union: {
          string: String,
          structure: {
            member: untyped
          },
          unit: {
          }
        }
      ) -> _OperationResponse
      | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _OperationResponse
  end
end
