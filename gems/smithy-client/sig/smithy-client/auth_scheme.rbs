module Smithy
  module Client
    class AuthScheme
      def initialize: (scheme_id: String, signer: Signer, identity_type: Class) -> void
      attr_reader scheme_id: String
      def identity_provider: (?Hash[Class, _IdentityProvider] identity_providers) -> _IdentityProvider?
      attr_reader signer: Signer
    end
  end
end
