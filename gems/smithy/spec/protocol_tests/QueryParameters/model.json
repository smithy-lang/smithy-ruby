{
    "smithy": "2.0",
    "shapes": {
        "smithy.ruby.tests.query#QueryParameters": {
            "type": "service",
            "version": "2026-10-22",
            "operations": [
                {
                    "target": "smithy.ruby.tests.query#GetThing"
                }
            ]
        },
        "smithy.ruby.tests.query#GetThing": {
            "type": "operation",
            "input": {
                "target": "smithy.api#Unit"
            },
            "output": {
                "target": "smithy.api#Unit"
            },
            "traits": {
                "smithy.test#httpRequestTests": [
                    {
                        "id": "EscapedUnicode",
                        "host": "example.com/?key=%F0%9F%98%B9",
                        "queryParams": [
                            "key=%F0%9F%98%B9"
                        ],
                        "method": "GET",
                        "uri": "/"
                    },
                    {
                        "id": "ReorderedRepeatedPairs",
                        "host": "example.com/?tag=b&tag=a&tag=a&extra=value",
                        "queryParams": [
                            "tag=a",
                            "tag=a",
                            "tag=b"
                        ],
                        "method": "GET",
                        "uri": "/"
                    },
                    {
                        "id": "EscapedParameterNames",
                        "host": "example.com/?escaped%20key=value",
                        "requireQueryParams": [
                            "escaped%20key"
                        ],
                        "forbidQueryParams": [
                            "absent%20key"
                        ],
                        "method": "GET",
                        "uri": "/"
                    },
                    {
                        "id": "ValuelessAndEmptyParameters",
                        "host": "example.com/?flag&key=",
                        "queryParams": [
                            "flag",
                            "key="
                        ],
                        "method": "GET",
                        "uri": "/"
                    },
                    {
                        "id": "EmptyQuery",
                        "host": "example.com/",
                        "queryParams": [],
                        "forbidQueryParams": [
                            "key"
                        ],
                        "method": "GET",
                        "uri": "/"
                    }
                ]
            }
        }
    }
}
