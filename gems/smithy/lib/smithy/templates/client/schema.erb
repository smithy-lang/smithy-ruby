# frozen_string_literal: true

# This is generated code!

module <%= module_name %>
  # This module contains a schema composed of shapes used by the client.
  module Schema
    include Smithy::Schema::Shapes

<% shapes.each do |shape| -%>
    <%= shape.name %> = <%= shape.type %>.<%= shape.new_method %>
<% end -%>

<% shapes_with_members.each do |shape| -%>
<% shape.members.each do |member| -%>
    <%= shape.name %>.<%= member.add_member_method(shape.type) %>
<% end -%>
<% if shape.type == 'UnionShape' -%>
    <%= shape.name %>.add_member(:unknown, 'unknown', Prelude::Unit, Types::<%= shape.name %>::Unknown)
<% end -%>
<% if shape.typed -%>
    <%= shape.name %>.type = Types::<%= shape.name %>
<% end -%>
<% end -%>

    SERVICE = ServiceShape.new do |service|
      service.id = "<%= service_shape.id %>"
      service.name = "<%= service_shape.name %>"
<% if service_shape.version? -%>
      service.version = "<%= service_shape.version %>"
<% end -%>
      service.traits = <%= service_shape.traits %>
<% operation_shapes.each do |shape| -%>
      service.add_operation(:<%= shape.symbol_name %>, OperationShape.new do |operation|
        operation.id = "<%= shape.id %>"
        operation.name = "<%= shape.name %>"
        operation.input = <%= shape.input %>
        operation.output = <%= shape.output %>
        operation.traits = <%= shape.traits %>
<% shape.errors.each do |err| -%>
        operation.errors << <%= err %>
<% end -%>
<% if !schema_type? && shape.paginated? -%>
        operation[:paginator] = <%= shape.paginator %>
<% end -%>
      end)
<% end -%>
    end
    TYPE_REGISTRY = Smithy::Schema::TypeRegistry.new
    TYPE_REGISTRY.register(<% shapes.each do |s| %><%= s.name %>, <% end %>)
  end
end
