module <%= module_name %>
  module Errors
<% errors.each do |error| -%>
    class <%= error.name %> < Smithy::Client::ServiceError
<% error.members.each do |member| -%>
      def <%= member.name %>: () -> <%= Model::RBS.type(model, member.target['target'], Model.shape(model, member.target['target'])) %>?
<% end -%>
<% if error.retryable? -%>
      def retryable?: () -> true
<% end -%>
<% if error.throttling? -%>
      def throttling?: () -> true
<% end -%>
    end
<% end -%>
  end
end
