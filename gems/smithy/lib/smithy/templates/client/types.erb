# frozen_string_literal: true

# This is generated code!

module <%= module_name %>
  # This module contains the types returned by client operations.
  module Types
<% types.each do |type| -%>

<% type.docstrings.each do |docstring| -%>
    # <%= docstring %>
<% end -%>
<% if type.type == 'structure' -%>
<% type.attribute_docstrings.each do |docstring| -%>
    # <%= docstring %>
<% end -%>
    class <%= type.name %> < Struct.new(
<% type.members.each do |member| -%>
      :<%= member.name.underscore %>,
<% end -%>
      keyword_init: true)
      include Smithy::Schema::Structure
<% if type.defaults.any? -%>

      def initialize(**args)
<% type.defaults.each do |member| -%>
        args[:<%= member.name.underscore %>] = <%= member.stringy_default? ? "'#{member.default}'" : member.default %> unless args.key?(:<%= member.name.underscore %>)
<% end -%>
        super
      end
<% end -%>
    end
<% elsif type.type == 'union' -%>
    class <%= type.name %> < Smithy::Schema::Union
<% type.members.each do |member| -%>
<% member.docstrings.each do |docstring| -%>
      # <%= docstring %>
<% end -%>
      class <%= member.name.camelize  %> < <%= type.name %>
        def to_h
          { <%= member.name.underscore %>: super(__getobj__) }
        end
      end

<% end -%>
      class Unknown < <%= type.name %>
        def initialize(name, value)
          super({ name: name, value: value })
        end

        def to_h
          { unknown: super(__getobj__) }
        end
      end
    end
<% end -%>
<% end -%>

  end
end
